 void SpinLock::Lock() {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    while (__atomic_exchange_n(&storage, 1, __ATOMIC_ACQUIRE) != 0) {
+        while (__atomic_load_n(&storage, __ATOMIC_RELAXED) != 0) {
